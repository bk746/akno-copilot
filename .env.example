# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Serveur uniquement — jamais exposé au navigateur
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Compte de service Google (Search Console) : contenu du fichier JSON encodé en base64
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Cloud → APIs → PageSpeed Insights API
PAGESPEED_API_KEY=

# Adresses autorisées sur /admin (séparées par des virgules)
ADMIN_EMAILS=you@akno.fr

# Secret pour les routes /api/cron/* (générer une chaîne aléatoire longue)
CRON_SECRET=

# Signature HMAC du cookie de déverrouillage (min. 32 caractères aléatoires)
PASSCODE_SECRET=

# Verrouillage 6 chiffres (/lock). Mettre false pour désactiver temporairement.
PASSCODE_ENABLED=true

# URL publique de l'app (production)
NEXT_PUBLIC_APP_URL=https://copilot.akno.fr
